pkgname=kuio
pkgver=0.0.0.r21.g3279b89
pkgrel=1
url="https://github.com/Rinnegatamante/kuio"
source=("git+https://github.com/Rinnegatamante/kuio.git#commit=3279b89558996b10d460bdd28ef7f2d4ca8a88a1" "vitasdk.patch")
sha256sums=('SKIP' 'SKIP')
depends=('taihen')

build() {
  cd $pkgname
  patch -Np0 -i ../vitasdk.patch
  mkdir build && cd build

  cmake .. -DCMAKE_TOOLCHAIN_FILE=$VITASDK/share/vita.toolchain.cmake -DCMAKE_INSTALL_PREFIX=$prefix
  make -j$(nproc)
}

package () {
  cd $pkgname/build
  make DESTDIR=$pkgdir install
}
