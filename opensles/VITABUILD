_follow=HEAD
sha256sums=('SKIP')
depends=('libsndfile')

build() {
  cd $pkgname/lib$pkgname
  make -j$(nproc)
}

package () {
  mkdir -p $pkgdir/$VITASDK/arm-vita-eabi/lib
  mkdir -p $pkgdir/$VITASDK/arm-vita-eabi/include
  
  cd $pkgname/lib$pkgname
  make DESTDIR="$pkgdir" install
}
