pkgname=openssl
pkgver=1.0.2.r12304.gcd52124
pkgrel=1
url="https://github.com/d3m3vilurr/vita-openssl"
source=("git+https://github.com/d3m3vilurr/vita-openssl.git#commit=cd52124ffc8e0f0fc8e2bdde93d4c022a0a7fc53")
_follow=HEAD
sha256sums=('SKIP')

build() {
  cd vita-openssl
  ./Configure no-threads --prefix=$VITASDK/arm-vita-eabi/ vita-cross
  make -j$(nproc) depend
  make -j$(nproc)
}

package () {
  cd vita-openssl
  printf '#!/bin/bash\nmkdir -p $@\n' > util/mkdir-p.pl
  make INSTALL_PREFIX=$pkgdir install
  rm -rf $pkgdir/$prefix/ssl/man # remove useless man pages
}
