pkgname=libvita2d_ext
pkgver=0.0.0.r4.gc3f5774
pkgrel=1
url="https://github.com/frangarcj/libvita2d_ext"
source=("git+https://github.com/frangarcj/libvita2d_ext.git#commit=c3f5774bac28a41c75b0ca1e7179656e01a943f2" "fini.patch")
_follow=HEAD
sha256sums=('SKIP' 'SKIP')
depends=('libvita2d')

build() {
  cd $pkgname
  patch -Np0 -i ../fini.patch
  cd $pkgname
  make -j$(nproc) CFLAGS='-Wl,-q -Wall -O3 -I$(INCLUDES)' # lto is broken on Windows vita-gcc for some reason
}


package () {
  cd $pkgname/$pkgname
  make DESTDIR=$pkgdir install
}
